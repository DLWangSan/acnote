<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting>true</EnableComHosting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>AcNote.WordAddin</RootNamespace>
    <AssemblyName>AcNote.WordAddin</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AcNote.Core\AcNote.Core.csproj" />
    <ProjectReference Include="..\AcNote.Word\AcNote.Word.csproj" />
    <ProjectReference Include="..\AcNote.Import.EndNote\AcNote.Import.EndNote.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\styles\*.style" Link="styles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
