<Window x:Class="AcNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AcNote"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="#F4F1EB"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4DFD6" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="AcNote" FontSize="20" FontWeight="SemiBold" Foreground="#0F5C5C" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="新建文献库" Click="NewLibrary_Click"/>
                        <Button Content="打开文献库" Click="OpenLibrary_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LibraryName" VerticalAlignment="Center" Foreground="#5C676B" Text="尚未打开文献库"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="新建文献" Click="New_Click"/>
                        <Button Content="保存" Click="Save_Click" Style="{StaticResource AccentButton}"/>
                        <Button Content="删除" Click="Delete_Click"/>
                        <Button Content="导入 EndNote" Click="ImportEndNote_Click"/>
                        <Button Content="编辑版式" Click="EditStyle_Click"/>
                        <Button Content="导入版式" Click="ImportStyle_Click"/>
                        <ComboBox x:Name="InsertFormCombo" Width="128" Margin="0,0,8,0" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="（作者，年）" Tag="parenthetical"/>
                            <ComboBoxItem Content="作者（年）" Tag="narrative"/>
                        </ComboBox>
                        <Button Content="插入到 Word" Click="InsertWord_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="版式" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#5C676B"/>
                        <ComboBox x:Name="StyleCombo" Width="220" Margin="0" DisplayMemberPath="DisplayName" SelectionChanged="StyleCombo_SelectionChanged"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4DFD6" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="SummaryText" Foreground="#1E2A2E"/>
                <TextBlock x:Name="WordStatusText" DockPanel.Dock="Right" Foreground="#5C676B" TextWrapping="Wrap" MaxWidth="640" TextAlignment="Right"/>
            </DockPanel>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,10" TextChanged="FilterBox_TextChanged">
                    <TextBox.Resources>
                        <VisualBrush x:Key="Hint" TileMode="None" Opacity="0.45" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="搜索题名或作者" Margin="10,6,0,0" Foreground="#5C676B"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Hint}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ListBox x:Name="ReferenceList" Background="White" BorderBrush="#E4DFD6" SelectionChanged="ReferenceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Meta}" Foreground="#5C676B" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding MissingText}" Foreground="#9C3B2E" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissing}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="文献类型" Foreground="#5C676B"/>
                            <ComboBox x:Name="TypeCombo" DisplayMemberPath="Label" SelectionChanged="Choice_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="语种" Foreground="#5C676B"/>
                            <ComboBox x:Name="LanguageCombo" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="自动判断" Tag=""/>
                                <ComboBoxItem Content="中文" Tag="zh"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="题名" Foreground="#5C676B"/>
                    <TextBox x:Name="TitleBox" TextChanged="Field_Changed"/>
                    <TextBlock Text="作者（每行一位；英文写作 Smith, John）" Foreground="#5C676B"/>
                    <TextBox x:Name="AuthorsBox" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="ContainerLabel" Text="刊名" Foreground="#5C676B"/>
                    <TextBox x:Name="ContainerBox" TextChanged="Field_Changed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="年份" Foreground="#5C676B"/>
                            <TextBox x:Name="YearBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="卷号" Foreground="#5C676B"/>
                            <TextBox x:Name="VolumeBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="期号" Foreground="#5C676B"/>
                            <TextBox x:Name="IssueBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="页码" Foreground="#5C676B"/>
                            <TextBox x:Name="PageBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PlaceLabel" Text="出版地" Foreground="#5C676B"/>
                            <TextBox x:Name="PlaceBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="PublisherLabel" Text="出版社" Foreground="#5C676B"/>
                            <TextBox x:Name="PublisherBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="DOI" Foreground="#5C676B"/>
                    <TextBox x:Name="DoiBox" TextChanged="Field_Changed"/>
                    <TextBlock Text="网址" Foreground="#5C676B"/>
                    <TextBox x:Name="UrlBox" TextChanged="Field_Changed"/>
                    <TextBlock Text="著录预览" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Background="White"/>
                    <TextBlock Text="当前版式缺项" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <TextBlock x:Name="CompleteText" Text="字段齐全" Foreground="#1F7A4D" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="MissingList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8E6E2" CornerRadius="4" Padding="8,3" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" Foreground="#9C3B2E"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
