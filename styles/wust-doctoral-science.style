{
  "id": "wust-doctoral-science",
  "name": "武汉科技大学博士论文（理工类）",
  "version": "1.1",
  "layout": "numeric",
  "group": "university",
  "status": "source-reviewed",
  "source": "用户提供《附件5-1 博士 论文编排式样（理工类）.doc》，参考文献章节（文件第15页）",
  "notes": "依据用户提供的博士理工类模板参考文献章节。中文全角逗号、冒号和期号括号；英文半角；句点、方括号和页码连字符保持半角，析出分隔符为∥。列表宋体/Times New Roman 12pt、1.25倍行距。版式自动管理“参考文献”标题，避免再手工重复输入。译者、编号、编者、日期在补充著录信息填写。英文刊名须为全称；已发表文献不得用预印本代替。正文上标是AcNote默认，原模板未明确。详见docs/styles/wust-doctoral-science.md。",
  "etAl": {
    "minCount": 4,
    "useFirst": 3,
    "zh": "，等",
    "en": ", et al.",
    "authorSeparatorZh": "，",
    "authorSeparatorEn": ", ",
    "familyInitialsSeparator": " ",
    "initialsSeparator": " ",
    "initialsUsePeriods": false
  },
  "citation": {
    "rangeSeparator": "-",
    "format": {
      "superscript": true,
      "fontFamily": "Times New Roman",
      "eastAsiaFontFamily": "宋体",
      "fontSize": 12
    }
  },
  "bibliographyHeading": "参考文献",
  "bibliographyHeadingFormat": {
    "fontFamily": "Times New Roman",
    "eastAsiaFontFamily": "黑体",
    "fontSize": 18,
    "bold": true,
    "superscript": false,
    "alignment": "center",
    "hangingIndent": 0,
    "lineSpacing": 1.25,
    "spaceBefore": 0,
    "spaceAfter": 0,
    "spaceAfterLines": 1,
    "pageBreakBefore": true
  },
  "bibliographyFormat": {
